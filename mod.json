{
	"geode": "5.11.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "siggmaez.gd-ai-builder",
	"name": "AI Builder",
	"version": "v0.3.0",
	"developer": "siggmaez",
	"description": "Minimal AI panel in the editor: builds gameplay and decoration through a local CLI bridge.",
	"resources": {
		"files": ["resources/object-whitelist.json", "resources/ai-builder-font.fnt", "resources/ai-builder-font.png", "resources/font-license.txt"]
	},
	"settings": {
		"cli": {
			"type": "string",
			"name": "CLI",
			"default": "codex",
			"one-of": ["claude", "codex", "gemini"]
		},
		"object-limit": {
			"type": "int",
			"name": "Object limit",
			"default": 300,
			"min": 1,
			"max": 1500
		},
		"panel-opacity": {
			"type": "int",
			"name": "Panel opacity",
			"default": 240,
			"min": 80,
			"max": 255
		},
		"bridge-url": {
			"type": "string",
			"name": "Bridge URL",
			"description": "Address of bridge.py (Termux on the phone or a PC on your Wi-Fi).",
			"default": "http://127.0.0.1:8765"
		}
	}
}
