{
  "geode": "5.11.1",
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "siggmaez.gd-ai-builder",
  "name": "AI Builder",
  "version": "v0.5.0",
  "developer": "siggmaez",
  "description": "Minimal AI panel in the editor: builds gameplay and decoration through a local CLI bridge.",
  "resources": {
    "files": [
      "resources/object-whitelist.json",
      "resources/ai-builder-font.fnt",
      "resources/ai-builder-font.png",
      "resources/font-license.txt",
      "resources/object-catalog.json"
    ]
  },
  "settings": {
    "cli": {
      "type": "string",
      "name": "CLI",
      "default": "codex",
      "one-of": [
        "claude",
        "codex",
        "gemini"
      ]
    },
    "object-limit": {
      "type": "int",
      "name": "Object limit",
      "default": 300,
      "min": 0,
      "description": "Maximum objects per generation. 0 = unlimited; large jobs are applied in batches."
    },
    "panel-opacity": {
      "type": "int",
      "name": "Panel opacity",
      "default": 240,
      "min": 80,
      "max": 255
    },
    "bridge-url": {
      "type": "string",
      "name": "Bridge URL",
      "description": "PC bridge address on the same Wi-Fi. No Termux is needed on Android.",
      "default": "http://127.0.0.1:8765"
    },
    "object-policy": {
      "type": "string",
      "name": "Object library",
      "default": "all",
      "one-of": [
        "all",
        "curated"
      ],
      "description": "All known GD IDs or the compact starter set."
    },
    "section-length": {
      "type": "int",
      "name": "Section length",
      "default": 3000,
      "min": 30,
      "max": 999000
    },
    "area-height": {
      "type": "int",
      "name": "Area height",
      "default": 3000,
      "min": 30,
      "max": 30000
    },
    "difficulty": {
      "type": "string",
      "name": "Difficulty",
      "default": "normal",
      "one-of": [
        "easy",
        "normal",
        "hard",
        "demon"
      ]
    },
    "decor-density": {
      "type": "string",
      "name": "Decor density",
      "default": "medium",
      "one-of": [
        "low",
        "medium",
        "high"
      ]
    },
    "allow-mode-changes": {
      "type": "bool",
      "name": "Allow mode changes",
      "default": true
    },
    "avoid-overlap": {
      "type": "bool",
      "name": "Avoid overlapping solid blocks",
      "default": true
    },
    "apply-batch": {
      "type": "int",
      "name": "Objects per frame",
      "default": 10,
      "min": 1,
      "max": 1000
    },
    "request-timeout": {
      "type": "int",
      "name": "Request timeout (seconds)",
      "default": 180,
      "min": 15
    },
    "reply-language": {
      "type": "string",
      "name": "AI reply language",
      "default": "auto",
      "one-of": [
        "auto",
        "ru",
        "en"
      ]
    },
    "model": {
      "type": "string",
      "name": "AI model",
      "default": "",
      "description": "Empty = CLI default. Use Model in the AI panel for account models."
    },
    "account-actions": {
      "type": "button",
      "name": "ChatGPT account",
      "buttons": {
        "sign-in": "Sign in with ChatGPT",
        "limits": "Remaining limits"
      },
      "description": "Official account login through your PC bridge. No API keys."
    }
  }
}
